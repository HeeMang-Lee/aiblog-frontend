# Notion 내부 통합(Internal Integration)의 시크릿.
# https://www.notion.so/profile/integrations 에서 만들고 ntn_ 으로 시작하는 값을 넣습니다.
# 절대 커밋하지 마세요. 이 파일은 예시이고 실제 값은 .env.local 에 둡니다.
NOTION_TOKEN=

# 글을 담을 노션 데이터베이스(표).
# 노션에서 "링크 복사"한 주소를 그대로 붙여넣으면 됩니다. ID만 넣어도 됩니다.
# 예: https://www.notion.so/heemang/1a2b3c...?v=9f8e...
NOTION_DATABASE_ID=

# 배포 주소. OG 태그의 절대 경로를 만드는 데 씁니다.
# 로컬에서는 비워두면 http://localhost:3000 으로 동작합니다.
NEXT_PUBLIC_SITE_URL=

# 방문자 카운터 (선택). https://console.upstash.com 에서 Redis 를 만들고
# REST API 탭의 두 값을 넣습니다. 비워두면 카운터 줄만 안 나오고
# 나머지는 그대로 동작합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
